# Godot files are LF-native; keep them LF everywhere to stop CRLF churn.
* text=auto eol=lf
*.png binary
*.ttf binary
*.fnt binary
*.ps1 text eol=crlf
assets/art_direction/**/*.glb filter=lfs diff=lfs merge=lfs -text
assets/art_direction/**/*.png filter=lfs diff=lfs merge=lfs -text
assets/art_direction/**/*.blend filter=lfs diff=lfs merge=lfs -text
assets/dice/*.png filter=lfs diff=lfs merge=lfs -text
assets/dice/*.glb filter=lfs diff=lfs merge=lfs -text
assets/table/*.png filter=lfs diff=lfs merge=lfs -text
assets/ui/*.png filter=lfs diff=lfs merge=lfs -text
assets/charms/*.png filter=lfs diff=lfs merge=lfs -text
assets/shop/*.png filter=lfs diff=lfs merge=lfs -text
